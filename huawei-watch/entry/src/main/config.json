{
  "app": {
    "bundleName": "ch.duartesantos.opengym.watch",
    "vendor": "openGym",
    "version": { "code": 1000000, "name": "0.1.0" }
  },
  "deviceConfig": {},
  "module": {
    "deviceType": ["liteWearable"],
    "distro": { "deliveryWithInstall": true, "moduleName": "entry", "moduleType": "entry" },
    "abilities": [{
      "name": ".MainAbility",
      "srcLanguage": "js",
      "srcPath": "MainAbility",
      "icon": "$media:icon",
      "description": "$string:MainAbility_desc",
      "label": "$string:MainAbility_label",
      "type": "page"
    }],
    "metaData": {
      "customizeData": [{
        "name": "supportLists",
        "value": "ch.duartesantos.opengym:REPLACE_WITH_PHONE_APP_FINGERPRINT",
        "extra": ""
      }]
    },
    "js": [{
      "pages": ["pages/index/index", "pages/mainPage/mainPage"],
      "name": ".MainAbility"
    }]
  }
}
